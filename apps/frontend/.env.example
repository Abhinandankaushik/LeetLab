# Frontend environment example. Copy to .env and fill in values.

# Backend API base URL (defaults to http://localhost:3000/api/v1 if unset)
VITE_API_URL="http://localhost:3000/api/v1"

# Real-time discussions WebSocket server (defaults to ws://<host>:4001 if unset)
VITE_WS_URL="ws://localhost:4001"

# Clerk publishable key for social login (Google / GitHub).
# Get it from https://dashboard.clerk.com -> API keys.
# Leave empty to disable social login (email/password keeps working).
VITE_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
