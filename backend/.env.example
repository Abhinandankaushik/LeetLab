# Example environment file for LeetLab backend
# Copy this file to .env and replace placeholder values before running

# PostgreSQL connection string
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>"

# JWT secret (keep private)
JWT_SECRET="<your-jwt-secret-here>"

PORT=3000
NODE_ENV="development"

# ---- Code execution queue (BullMQ + Redis) ----
# Redis connection used to queue & throttle code executions so concurrent
# submissions don't overwhelm the executor / the server.
REDIS_URL="redis://localhost:6379"
# Set to "false" to bypass the queue and run executions inline (no Redis needed).
QUEUE_ENABLED="false"
# Max code executions processed at the same time (the throttle).
EXECUTION_CONCURRENCY=5
# Max ms a request waits for its queued execution to finish.
EXECUTION_JOB_TIMEOUT_MS=120000

# ---- Code execution backend (warm-container pool, src/executor) ----
# Requires access to a Docker engine (mount /var/run/docker.sock in containers).
# Pools to warm at boot (others are created lazily on first use): python,node,java,gcc
EXECUTOR_LANGUAGES="python,gcc"
# Warm containers kept per pool.
POOL_PYTHON=2
POOL_GCC=2
POOL_JAVA=1
POOL_NODE=1
# Per-container resource limits.
EXECUTOR_MEMORY_MB=256
EXECUTOR_CPUS=1
EXECUTOR_PIDS=128
# Time limits (seconds).
EXECUTOR_COMPILE_TIMEOUT_S=15
EXECUTOR_RUN_TIMEOUT_S=5

# Clerk (social login - Google / GitHub). Get from https://dashboard.clerk.com -> API keys
# Only the SECRET key is needed on the backend. Leave empty to disable social login.
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
